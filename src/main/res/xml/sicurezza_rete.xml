<?xml version="1.0" encoding="utf-8"?>
<!-- Solo connessioni cifrate e solo certificati ufficiali di sistema:
     certificati installati da altri non possono intercettare l'app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
